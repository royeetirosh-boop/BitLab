{
  "name": "bitlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:update": "node --test src/lib/appUpdate.test.mjs",
    "mobile:sync": "npm run build && npx cap sync",
